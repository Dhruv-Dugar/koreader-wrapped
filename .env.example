# KoReader Wrapped - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Your app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# DATABASE (Optional - for user persistence)
# ===========================================

# PostgreSQL connection string (Supabase, Neon, or local)
# DATABASE_URL=postgresql://user:password@localhost:5432/koreader_wrapped

# ===========================================
# STORAGE (Optional - for file persistence)
# ===========================================

# AWS S3 or compatible (Cloudflare R2, MinIO)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://your-endpoint.com (optional, for R2/MinIO)

# ===========================================
# REDIS (Optional - for caching/leaderboards)
# ===========================================

# Redis URL (Upstash or local)
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
